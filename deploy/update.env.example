# Server-local configuration for deploy/update-from-github.sh.
# Copy this file to a private path on the deployment host and adjust values.
STQB_PROJECT_DIR=/srv/study-qb-assistant
STQB_SOURCE_REPOSITORY=MelodyKnit/SmartAnswer
STQB_HEALTH_URL=http://127.0.0.1:3003
# Set this to the output of `docker context show` for the deployment user.
STQB_DOCKER_CONTEXT=rootless
STQB_PLATFORM=linux/amd64
STQB_ALLOW_DOWNGRADE=false
# Build the exact validated Release source locally when the GHCR package is
# private or temporarily unavailable.
STQB_ALLOW_SOURCE_FALLBACK=true

# Leave these unset for a public repository and public GHCR package.
# For a private repository/package, use local files with mode 600.
# STQB_GITHUB_TOKEN_FILE=/etc/study-qb-assistant/github-token
# STQB_GHCR_USERNAME=your-github-user
# STQB_GHCR_TOKEN_FILE=/etc/study-qb-assistant/ghcr-token

# Optional: pin this server to one release instead of following /releases/latest.
# STQB_RELEASE_TAG=v0.7.0
