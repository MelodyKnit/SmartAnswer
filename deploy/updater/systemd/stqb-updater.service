[Unit]
Description=Process SmartAnswer update command queue
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/stqb-updater.env
ExecStart=/usr/bin/python3 /usr/local/lib/stqb-updater/stqb_updater.py process
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
