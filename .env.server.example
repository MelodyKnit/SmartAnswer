STQB_DATA_DIR=/app/data
STQB_PUBLIC_BASE_URL=https://ocs.example.com
STQB_REGISTRATION_ENABLED=true
STQB_LLM_BASE_URL=http://host.docker.internal:3000/v1
STQB_LLM_MODEL=gpt-5.4
STQB_LLM_API_KEY=replace-with-your-api-key
STQB_LLM_STREAM=true
STQB_LLM_MAX_COMPLETION_TOKENS=700
STQB_WEB_SEARCH_PROVIDER=bing
# Optional: if the server relies on a host-side proxy for external search access.
# STQB_SEARCH_PROXY=http://host.docker.internal:7890
STQB_REQUIRE_AUTH=true
